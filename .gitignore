# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments (one per project, deliberately not shared)
.venv/
venv/

# DriftSentry runtime state: baselines, proxy logs, alerts, the Chroma store.
# Regenerated by running the tool; never part of the source.
.driftsentry_data/

# Attacker runtime state: the scenario file and the sink it writes to.
# These normally live in a fixed per-user directory, but a run pointed at the
# working directory would drop them here. Neither belongs in version control:
# the sink holds whatever an attack captured, and a committed scenario would let
# a fresh clone start up already armed.
.attacker/
sink/
scenario.json
scenario_*.json

# Scratch space used while debugging
.diag/
.demo/
.testbed/
*.log

# Evaluation outputs - regenerated from seeds, so the scripts are the artefact,
# not the results.
eval/results/
eval/plots/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
